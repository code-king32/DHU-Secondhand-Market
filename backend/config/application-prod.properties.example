# 复制到部署目录 config/application-prod.properties，启动时加载外部 prod 配置。
# local/prod 环境配置不进入交付 JAR；详见 docs/07-运行与部署.md。
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.mail.host=${MAIL_HOST}
spring.mail.port=${MAIL_PORT:465}
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.ssl.enable=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

# 由维护人员预先执行全部业务及 runtime-schema.sql；运行账号无需建表权限。
spring.sql.init.mode=never
server.servlet.session.cookie.secure=true
app.images.directory=${IMAGE_DIRECTORY}
app.mail.key-file=${MAIL_KEY_FILE}
app.web.allowed-origins=${WEB_ALLOWED_ORIGINS}
app.web.trusted-proxies=${TRUSTED_PROXIES:}
# 保留 TCP 对端地址，由应用按可信代理名单解释 X-Forwarded-For。
server.forward-headers-strategy=none
